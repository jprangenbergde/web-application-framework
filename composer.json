{
    "name": "jprangenbergde/app",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Framework\\": "framework/src"
        },
        "files": [
            "framework/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jens Prangenberg",
            "email": "mail@jpra.de"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "flow-php/array-dot": "^0.46",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "filp/whoops": "^2.18",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^8.1",
        "vimeo/psalm": "^6.20"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "scripts": {
        "codestyle-fix": "php-cs-fixer fix",
        "codestyle-check": [
            "php-cs-fixer check",
            "deptrac"
        ],
        "test": "phpunit"
    }
}
